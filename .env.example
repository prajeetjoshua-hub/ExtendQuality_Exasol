# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend
EXTENDQUALITY_ENVIRONMENT=development
EXTENDQUALITY_API_HOST=127.0.0.1
EXTENDQUALITY_API_PORT=8000
EXTENDQUALITY_DATABASE_PATH=storage/metadata/extendquality.db
EXTENDQUALITY_STORAGE_PATH=storage
EXTENDQUALITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
EXTENDQUALITY_MAX_UPLOAD_BYTES=10485760
EXTENDQUALITY_YOLO_WEIGHTS=models/weights/bearing_real_3class.pt
EXTENDQUALITY_YOLO_CONFIDENCE=0.35
EXTENDQUALITY_DECISION_CONFIDENCE=0.70
EXTENDQUALITY_NORMAL_ACCEPT_CONFIDENCE=0.80
EXTENDQUALITY_RECAPTURE_QUALITY=0.45

# Optional live VLM; demo mode makes no external API calls.
EXTENDQUALITY_VLM_PROVIDER=demo
EXTENDQUALITY_VLM_API_KEY=
EXTENDQUALITY_VLM_MODEL=gemini-3.6-flash
EXTENDQUALITY_VLM_TIMEOUT_SECONDS=45

# Exasol Personal analytics (disabled preserves local inspection)
EXASOL_ENABLED=false
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=
EXASOL_PASSWORD=
EXASOL_SCHEMA=EQ_HACKATHON
EXASOL_CA_FILE=
# Explicit loopback-only self-signed development option; prefer trusted CA.
EXASOL_LOCAL_INSECURE=false
